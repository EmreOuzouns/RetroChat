{
  "appId": "com.retrochat.app",
  "appName": "RetroChat",
  "webDir": "www",
  "server": {
    "url": "https://retrochat-server-production.up.railway.app",
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "allowNavigation": ["retrochat-server-production.up.railway.app", "accounts.spotify.com"]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
